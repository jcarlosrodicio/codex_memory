{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/plugins/codex-memory/adapters/codex/bin/codex-memory-hook.mjs\" SessionStart",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/plugins/codex-memory/adapters/codex/bin/codex-memory-hook.mjs\" UserPromptSubmit",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/plugins/codex-memory/adapters/codex/bin/codex-memory-hook.mjs\" Stop",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
