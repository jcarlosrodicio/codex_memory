{
  "spec_id": "SPEC-007",
  "redaction_policy_version": "1",
  "redaction_pipeline": {
    "applies_before_durable_writes": true,
    "gate_is_mandatory": true,
    "scan_targets": [
      "candidate_memory_atoms",
      "candidate_memory_edges",
      "candidate_memory_capsules"
    ]
  },
  "persistence_outcomes": {
    "allowed_states": ["allow", "redact", "block"],
    "explainability": {
      "required": true,
      "required_fields": [
        "outcome",
        "reason_codes",
        "transformation_summary",
        "audit_ref"
      ]
    }
  },
  "detection_coverage": {
    "structured_secrets": [
      "api_keys",
      "access_tokens",
      "credentials",
      "private_keys"
    ],
    "free_text_leaks": [
      "password_disclosures",
      "token_pastes",
      "secret_reveal_phrases"
    ]
  },
  "durable_enforcement": {
    "bypass_allowed": false,
    "blocked_content_persisted_raw": false,
    "required_for_durable_objects": ["MemoryAtom", "MemoryEdge", "MemoryCapsule"]
  },
  "fallback_behavior": {
    "uncertain_classification_default": "block",
    "optional_backend_failure": "continue_with_local_safety_gates"
  },
  "invariants": [
    "No durable memory object bypasses redaction checks.",
    "Blocked content is never silently persisted in raw form.",
    "Safety behavior is visible in audit artifacts.",
    "Retroactive cleanup of already-shipped user data is out of scope for SPEC-007."
  ]
}
